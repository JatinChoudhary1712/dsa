   "source": [
    "class Solution:    \n",
    "    def divisibleByDigits(self, s):\n",
    "        count = 0 \n",
    "        n = int(s)\n",
    "        \n",
    "        for ch in s:\n",
    "            digit = int(ch)\n",
    "            \n",
    "            if digit != 0 and n % digit == 0:\n",
    "                count += 1\n",
    "        \n",
    "        return count"
   ]
